# Ivyea Note 部署环境变量（复制为 .env 后填写）
# JWT 签名密钥：openssl rand -hex 32
IVNOTE_SECRET=change-me-openssl-rand-hex-32
# Postgres 密码：openssl rand -hex 16
POSTGRES_PASSWORD=change-me-openssl-rand-hex-16

# 管理员账号（部署者登录用；不填邮箱则默认 admin@example.com）
IVNOTE_ADMIN_EMAIL=admin@example.com
# 管理员密码；留空 = 首次启动自动生成随机密码并打印到容器日志（docker logs 查看）
IVNOTE_ADMIN_PASSWORD=

# 是否开放公开注册（自托管建议保持 false）
IVNOTE_OPEN_REGISTRATION=false
