<?xml version="1.0" encoding="utf-8"?>
<!-- 待办的预览：只给 Android 12+ 的小部件选择器当 previewLayout 用，真实小部件走 ivw_list + addView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ivw_bg"
    android:paddingStart="@dimen/ivw_list_pad"
    android:paddingEnd="@dimen/ivw_list_pad"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ivw_list_header_h"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/ivw_todo_widget_label" android:textColor="@color/ivw_text" android:textSize="13sp"
            android:fontFamily="sans-serif-medium" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="1dp" android:paddingBottom="1dp"
            android:background="@drawable/ivw_pill" android:text="@string/ivw_preview_count" android:textColor="@color/ivw_accent"
            android:textSize="10sp" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:padding="6dp"
            android:background="@drawable/ivw_plus_circle" android:src="@drawable/ivw_ic_plus" android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:divider="@drawable/ivw_hairline"
        android:showDividers="middle">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ivw_row_h"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="34dp" android:layout_height="@dimen/ivw_row_h" android:paddingEnd="12dp"
            android:paddingTop="6dp" android:paddingBottom="6dp" android:src="@drawable/ivw_ic_ring" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ivw_preview_t1_text" android:textColor="@color/ivw_text" android:textSize="14sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="@string/ivw_preview_t1_note" android:textColor="@color/ivw_muted" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ivw_row_h"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="34dp" android:layout_height="@dimen/ivw_row_h" android:paddingEnd="12dp"
            android:paddingTop="6dp" android:paddingBottom="6dp" android:src="@drawable/ivw_ic_ring" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ivw_preview_t2_text" android:textColor="@color/ivw_text" android:textSize="14sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="@string/ivw_preview_t2_note" android:textColor="@color/ivw_muted" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ivw_row_h"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="34dp" android:layout_height="@dimen/ivw_row_h" android:paddingEnd="12dp"
            android:paddingTop="6dp" android:paddingBottom="6dp" android:src="@drawable/ivw_ic_ring" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ivw_preview_t3_text" android:textColor="@color/ivw_text" android:textSize="14sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:text="@string/ivw_preview_t3_note" android:textColor="@color/ivw_muted" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
