<?xml version="1.0" encoding="utf-8"?>
<!--
  笔记卡片：默认 2×2，可横竖拉伸（4×2 更像便签、4×4 能看一整段）。
  尺寸公式：n 格 = 70×n − 30 dp。updatePeriodMillis=0：内容由 App 推，不让系统定时唤醒。
  targetCell* / previewLayout / description 是 Android 12 的属性，旧系统忽略。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/ivw_note"
    android:previewLayout="@layout/ivw_note"
    android:previewImage="@drawable/ivw_preview"
    android:description="@string/ivw_note_widget_desc"
    android:widgetCategory="home_screen" />
