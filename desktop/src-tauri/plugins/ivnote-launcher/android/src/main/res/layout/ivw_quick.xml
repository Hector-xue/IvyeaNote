<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷创建（2×1）：左半边「新建笔记」，点了直接新建；右边圆形日历钮进今日日记。
  2×1 只有 150dp 宽，放不下 logo + 名字 + 两个钮，所以不放 logo（选择器里已经有应用名）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/ivw_bg"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/ivw_quick_new"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ivw_quick_new"
            android:textColor="@color/ivw_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/ivw_quick_new_sub"
            android:textColor="@color/ivw_muted"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivw_quick_daily"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="9dp"
        android:background="@drawable/ivw_plus_circle"
        android:src="@drawable/ivw_ic_daily"
        android:contentDescription="@string/ivw_daily" />
</LinearLayout>
