<?xml version="1.0" encoding="utf-8"?>
<!-- 快捷创建（2×1）：左半边打开应用，右边圆形 ＋ 新建笔记 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/ivw_bg"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/ivw_quick_open"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ivw_quick_open"
            android:textColor="@color/ivw_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ivw_quick_open_sub"
            android:textColor="@color/ivw_muted"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivw_quick_new"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:background="@drawable/ivw_plus_circle"
        android:src="@drawable/ivw_ic_plus"
        android:contentDescription="@string/ivw_quick_new" />
</LinearLayout>
