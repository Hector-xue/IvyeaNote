<?xml version="1.0" encoding="utf-8"?>
<!--
  笔记卡片：标题 / 正文 / 底栏（相对时间 + 右下角铅笔钮）。
  只用 RemoteViews 认识的控件（LinearLayout / ImageView / TextView）。
  ivw_pad / ivw_header_h / ivw_footer_h / ivw_line_h 与 NoteWidget.bodyLines 联动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ivw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ivw_bg"
    android:padding="@dimen/ivw_pad">

    <TextView
        android:id="@+id/ivw_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ivw_header_h"
        android:gravity="center_vertical"
        android:text="@string/ivw_preview_title"
        android:textColor="@color/ivw_text"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/ivw_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:text="@string/ivw_preview_body"
        android:textColor="@color/ivw_body"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ivw_footer_h"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ivw_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ivw_preview_time"
            android:textColor="@color/ivw_muted"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/ivw_edit"
            android:layout_width="@dimen/ivw_fab"
            android:layout_height="@dimen/ivw_fab"
            android:padding="7dp"
            android:background="@drawable/ivw_plus_circle"
            android:src="@drawable/ivw_ic_edit"
            android:contentDescription="@string/ivw_continue_writing" />
    </LinearLayout>
</LinearLayout>
