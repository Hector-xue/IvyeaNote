{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "fs-base",
  "description": "允许读写用户选择的 vault 文件夹（** 递归）",
  "windows": ["main"],
  "permissions": [
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-stat",
    "fs:allow-watch",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }, { "path": "/**" }]
    },
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:allow-restart"
  ]
}
