{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "fs-base",
  "description": "允许读写用户选择的 vault 文件夹（** 递归）；把附件交给系统应用打开（opener 有一套**独立于 fs:scope** 的路径作用域，allow-open-path 官方说明就是 without any pre-configured scope，不给作用域就一律 Not allowed to open path）；以及 Windows 自绘边框需要的窗口控制（最小化/最大化/关闭/拖动）",
  "windows": [
    "main"
  ],
  "permissions": [
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-stat",
    "fs:allow-watch",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "/**"
        }
      ]
    },
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "obsidian://*"
        }
      ]
    },
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-close",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "ivnote-saf:default",
    "ivnote-launcher:default"
  ]
}
